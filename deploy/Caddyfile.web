{
  admin off
  auto_https off
}

:8080 {
  encode zstd gzip
  header X-Content-Type-Options nosniff
  header X-Release {$RELEASE_ID}

  handle /api/* {
    reverse_proxy api:4000 {
      transport http {
        dial_timeout 3s
        response_header_timeout 10s
      }
    }
  }

  handle /_astro/* {
    root * /srv/site
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  @legacy path /assets/* /css/* /js/* /backsound-wedding.mp3 /Aliva-thebride.jpeg /Andrika-Thegroom.jpeg
  handle @legacy {
    root * /srv/legacy
    header Cache-Control "public, max-age=3600"
    file_server
  }

  handle {
    root * /srv/site
    header Cache-Control no-cache
    file_server
  }
}

