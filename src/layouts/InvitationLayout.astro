---
import { getImage } from 'astro:assets';

import coverPhoto from '../../assets/couple/animated-couple-cover.webp';
import ogCard from '../../assets/social/og-card.jpg';
import faviconLogo from '../../assets/brand/andrika-aliva0logo.svg';
import Cover from '../components/Cover.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import { site } from '../data/wedding.ts';
import { DEFAULT_LOCALE } from '../i18n/index.ts';
import '../styles/global.css';

/**
 * The cover photograph is the mobile LCP. It is emitted once here, preloaded
 * in the head and handed to the cover as a custom property, so the preload
 * and the paint can never point at two different files.
 */
const cover = await getImage({ src: coverPhoto, width: 1000, format: 'webp' });

/**
 * Social previews need an absolute URL; a relative one shows no image.
 *
 * The card is already composed at 1200x630 by tools/build-og-card.mjs, so it
 * is imported rather than run through getImage: re-encoding it here would
 * only cost quality.
 */
const ogImageUrl = new URL(ogCard.src, site.url).href;
const canonical = new URL(Astro.url.pathname, site.url).href;

const locale = DEFAULT_LOCALE;
---

<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- The invitation is a warm-paper design with photographs on it. An
         OS dark preference must not repaint any of that. -->
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.ogDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogCard.width)} />
    <meta property="og:image:height" content={String(ogCard.height)} />
    <meta property="og:image:alt" content="Ilustrasi Andrika dan Aliva, dengan Aliva memegang buket pengantin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Ilustrasi Andrika dan Aliva, dengan Aliva memegang buket pengantin" />

    <link rel="preload" href={cover.src} as="image" type="image/webp" fetchpriority="high" />

    <!--
      Without scripting the cover has no way to open, so it would seal the
      invitation shut. Everything that genuinely needs JavaScript steps aside
      here and says so, instead of showing dead controls.
    -->
    <noscript>
      <style>
        #cover-screen,
        #music-widget,
        #language-switcher,
        .when-countdown,
        #rsvp-form,
        #rsvp-guestbook-status,
        #rsvp-entries-viewport,
        .gift-copy-btn {
          display: none !important;
        }

        .no-js-note {
          display: block !important;
        }
      </style>
    </noscript>

    <link rel="icon" type="image/svg+xml" href={faviconLogo.src} />
  </head>

  <body class="antialiased">
    <LanguageSwitcher />

    <!-- Atmosphere: drifting petals and a whisper of grain, both fixed
         behind the story and both inert to assistive technology. -->
    <canvas id="petalCanvas" aria-hidden="true"></canvas>
    <div id="grain" aria-hidden="true"></div>

    <Cover photoUrl={cover.src} />

    <!-- ScrollSmoother transforms only this pair. The cover, the switcher
         and the music control stay outside so they can remain fixed. -->
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
      </div>
    </div>

    <MusicPlayer />

    <script>
      import '../scripts/main.ts';
    </script>

    <!--
      Same failure, different cause: if the module never arrives the cover
      button does nothing. This releases the invitation rather than leaving a
      guest staring at a ticket that will not tear.
    -->
    <script is:inline>
      window.setTimeout(() => {
        if (document.documentElement.dataset.invitationReady === 'true') return;
        const cover = document.getElementById('cover-screen');
        if (!cover) return;
        cover.remove();
        document.body.style.overflow = '';
        document.querySelectorAll('.reveal').forEach((element) => element.classList.add('visible'));
      }, 8000);
    </script>

    <!--
      GSAP is only fetched on pointer-precise desktop viewports that will
      actually run the scroll story. Deciding here, before the module loads,
      keeps three CDN requests off every phone.
    -->
    <script is:inline>
      (() => {
        const useNativeScroll =
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          window.matchMedia('(max-width: 767px), (max-height: 699px), (pointer: coarse)').matches ||
          navigator.maxTouchPoints > 0;

        const sources = [
          'https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js',
          'https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js',
          'https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollSmoother.min.js',
        ];

        const loadScript = (src) =>
          new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = src;
            script.onload = resolve;
            script.onerror = () => reject(new Error(`Failed to load ${src}`));
            document.head.appendChild(script);
          });

        window.__scrollStoryReady = useNativeScroll
          ? Promise.resolve()
          : sources.reduce((chain, src) => chain.then(() => loadScript(src)), Promise.resolve());
      })();
    </script>
  </body>
</html>
