---
import { site } from '../data/wedding.ts';
import '../styles/guest-manager.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={site.themeColor} />
    <title>Pengelola Undangan | Andrika &amp; Aliva</title>
  </head>
  <body class="guest-manager-page">
    <main id="guest-manager-app" data-invitation-base-url={site.url}>
      <section id="guest-login-panel" class="gm-auth-panel" aria-labelledby="login-heading">
        <p class="gm-eyebrow">Andrika &amp; Aliva</p>
        <h1 id="login-heading">Pengelola Undangan</h1>
        <p class="gm-lead">Masukkan kode akses bersama untuk melihat dan memperbarui daftar tamu.</p>
        <form id="guest-login-form" class="gm-form" novalidate>
          <label class="gm-label" for="access-code">Kode akses</label>
          <input id="access-code" class="gm-input" name="code" type="password" autocomplete="current-password" required />
          <p id="login-error" class="gm-error" role="alert" hidden></p>
          <button class="gm-button gm-button--primary" type="submit">Buka Pengelola Undangan</button>
        </form>
      </section>

      <section id="guest-dashboard" hidden aria-labelledby="dashboard-heading">
        <header class="gm-header">
          <div>
            <p class="gm-eyebrow">Andrika &amp; Aliva</p>
            <h1 id="dashboard-heading">Daftar Undangan</h1>
            <p class="gm-subtitle">Cari nama, salin pesan, lalu tandai saat sudah dikirim.</p>
          </div>
          <div class="gm-header-actions">
            <button id="template-button" class="gm-button gm-button--quiet" type="button">Template Pesan</button>
            <button id="logout-button" class="gm-button gm-button--quiet" type="button">Keluar</button>
            <button id="add-guest-button" class="gm-button gm-button--primary" type="button">Tambah Tamu</button>
          </div>
        </header>

        <div class="gm-toolbar" aria-label="Penyaringan daftar tamu">
          <label class="gm-search-label" for="guest-search">
            <span class="sr-only">Cari nama tamu</span>
            <input id="guest-search" class="gm-input" type="search" placeholder="Cari nama tamu" autocomplete="off" />
          </label>
          <label class="sr-only" for="guest-category-filter">Kategori atau style kata</label>
          <select id="guest-category-filter" class="gm-input gm-select">
            <option value="">Semua kategori</option>
            <optgroup label="Default Template">
              <option value="personal">Personal</option>
              <option value="group">Group</option>
              <option value="titled">Personal Bergelar</option>
            </optgroup>
            <optgroup label="Style Kata">
              <option value="style:ibu_family">Ibu &amp; Keluarga</option>
              <option value="style:bapak_family">Bapak &amp; Keluarga</option>
              <option value="style:ibu_bapak_family">Ibu &amp; Bapak Keluarga</option>
              <option value="style:bapak_ibu_family">Bapak &amp; Ibu Keluarga</option>
            </optgroup>
          </select>
          <label class="sr-only" for="guest-status-filter">Status</label>
          <select id="guest-status-filter" class="gm-input gm-select">
            <option value="">Semua status</option>
            <option value="pending">Belum dikirim</option>
            <option value="copied">Sudah disalin</option>
            <option value="sent">Sudah dikirim</option>
          </select>
          <button id="refresh-guests-button" class="gm-button gm-button--quiet" type="button">Muat ulang</button>
        </div>

        <nav id="guest-group-tabs" class="gm-tabs" aria-label="Kelompok tamu">
          <button class="gm-tab is-active" type="button" data-group="">Semua</button>
          <button class="gm-tab" type="button" data-group="friend_andrika">Teman Andrika</button>
          <button class="gm-tab" type="button" data-group="friend_aliva">Teman Aliva</button>
          <button class="gm-tab" type="button" data-group="parent_friend_andrika">Teman Orang Tua Andrika</button>
          <button class="gm-tab" type="button" data-group="parent_friend_aliva">Teman Orang Tua Aliva</button>
        </nav>

        <div class="gm-list-heading">
          <p id="guest-count" class="gm-count" aria-live="polite"></p>
        </div>
        <div id="guest-list-status" class="gm-state" role="status" aria-live="polite"></div>
        <ul id="guest-list" class="gm-list" aria-label="Daftar tamu"></ul>
      </section>
    </main>

    <dialog id="guest-dialog" class="gm-dialog gm-dialog--slideout" aria-labelledby="guest-dialog-heading">
      <form id="guest-form" class="gm-dialog-form" novalidate>
        <div class="gm-dialog-header">
          <div>
            <p class="gm-eyebrow">Data tamu</p>
            <h2 id="guest-dialog-heading">Tambah Tamu</h2>
          </div>
          <button class="gm-icon-button" type="button" data-close-dialog="guest-dialog" aria-label="Tutup form">×</button>
        </div>
        <input id="guest-id" type="hidden" />
        <input id="guest-version" type="hidden" />
        <div class="gm-form-grid">
          <div class="gm-field gm-field--wide">
            <label class="gm-label" for="guest-style">Style kata</label>
            <select id="guest-style" class="gm-input gm-select" name="wording_style" required>
              <option value="default">Default Template</option>
              <option value="ibu_family">Ibu &amp; Keluarga</option>
              <option value="bapak_family">Bapak &amp; Keluarga</option>
              <option value="ibu_bapak_family">Ibu &amp; Bapak Keluarga</option>
              <option value="bapak_ibu_family">Bapak &amp; Ibu Keluarga</option>
            </select>
            <p class="gm-help">Style menentukan sapaan yang tercetak di undangan, dan nama mana saja yang diminta di bawah.</p>
          </div>
          <div class="gm-field gm-field--wide">
            <label class="gm-label" id="guest-name-label" for="guest-name">Nama yang diundang</label>
            <input id="guest-name" class="gm-input" name="name" maxlength="60" required />
          </div>
          <div class="gm-field gm-field--wide" id="second-name-field" hidden>
            <label class="gm-label" id="guest-second-name-label" for="guest-second-name">Nama kedua</label>
            <input id="guest-second-name" class="gm-input" name="second_name" maxlength="60" />
          </div>
          <div class="gm-field" id="category-field">
            <label class="gm-label" for="guest-category">Kategori</label>
            <select id="guest-category" class="gm-input gm-select" name="category" required>
              <option value="personal">Personal</option>
              <option value="group">Group</option>
              <option value="titled">Personal Bergelar</option>
            </select>
          </div>
          <div class="gm-field">
            <label class="gm-label" for="guest-group">Kelompok tamu</label>
            <select id="guest-group" class="gm-input gm-select" name="relationship_group" required>
              <option value="friend_andrika">Teman Andrika</option>
              <option value="friend_aliva">Teman Aliva</option>
              <option value="parent_friend_andrika">Teman Orang Tua Andrika</option>
              <option value="parent_friend_aliva">Teman Orang Tua Aliva</option>
            </select>
          </div>
          <div class="gm-field gm-field--wide">
            <label class="gm-label" for="guest-template">Template pesan</label>
            <select id="guest-template" class="gm-input gm-select" name="template_key" required>
              <option value="friend">Template Untuk Teman</option>
              <option value="parent">Template Untuk Orang Tua</option>
            </select>
            <p class="gm-help">Pesan yang disalin lewat tombol Salin Pesan. Mengikuti kelompok tamu sampai Anda memilih sendiri.</p>
          </div>
        </div>

        <div id="title-sections">
          <section class="gm-title-block" id="title-block-1" hidden>
            <fieldset class="gm-choice" id="title-question-1" hidden>
              <legend class="gm-label" id="title-question-legend-1">Apakah tamu ini mempunyai gelar?</legend>
              <label class="gm-choice-option">
                <input type="radio" name="has-title-1" value="tidak" checked />
                <span>Tidak</span>
              </label>
              <label class="gm-choice-option">
                <input type="radio" name="has-title-1" value="ya" />
                <span>Ya</span>
              </label>
            </fieldset>
            <div class="gm-title-controls" id="title-controls-1" hidden>
              <label class="gm-label" id="title-picker-label-1" for="title-picker-1">Gelar</label>
              <div class="gm-title-picker">
                <select id="title-picker-1" class="gm-input gm-select">
                  <option value="">Pilih gelar</option>
                </select>
                <button id="add-custom-title-button-1" class="gm-button gm-button--quiet" type="button">Tambah manual</button>
              </div>
              <div id="custom-title-row-1" class="gm-custom-title-row" hidden>
                <label class="sr-only" for="custom-title-1">Gelar manual</label>
                <input id="custom-title-1" class="gm-input" maxlength="32" placeholder="Contoh: S.Kom" />
                <label class="sr-only" for="custom-title-placement-1">Posisi gelar manual</label>
                <select id="custom-title-placement-1" class="gm-input gm-select">
                  <option value="prefix">Di depan nama</option>
                  <option value="suffix">Di belakang nama</option>
                </select>
                <button id="save-custom-title-button-1" class="gm-button gm-button--quiet" type="button">Simpan gelar</button>
              </div>
              <div id="selected-titles-1" class="gm-selected-titles" aria-live="polite"></div>
              <p class="gm-help">Gelar depan tercetak sebelum nama, gelar belakang setelah nama. Urutannya dapat diubah.</p>
            </div>
          </section>
          <section class="gm-title-block" id="title-block-2" hidden>
            <fieldset class="gm-choice" id="title-question-2" hidden>
              <legend class="gm-label" id="title-question-legend-2">Apakah tamu ini mempunyai gelar?</legend>
              <label class="gm-choice-option">
                <input type="radio" name="has-title-2" value="tidak" checked />
                <span>Tidak</span>
              </label>
              <label class="gm-choice-option">
                <input type="radio" name="has-title-2" value="ya" />
                <span>Ya</span>
              </label>
            </fieldset>
            <div class="gm-title-controls" id="title-controls-2" hidden>
              <label class="gm-label" id="title-picker-label-2" for="title-picker-2">Gelar</label>
              <div class="gm-title-picker">
                <select id="title-picker-2" class="gm-input gm-select">
                  <option value="">Pilih gelar</option>
                </select>
                <button id="add-custom-title-button-2" class="gm-button gm-button--quiet" type="button">Tambah manual</button>
              </div>
              <div id="custom-title-row-2" class="gm-custom-title-row" hidden>
                <label class="sr-only" for="custom-title-2">Gelar manual</label>
                <input id="custom-title-2" class="gm-input" maxlength="32" placeholder="Contoh: S.Kom" />
                <label class="sr-only" for="custom-title-placement-2">Posisi gelar manual</label>
                <select id="custom-title-placement-2" class="gm-input gm-select">
                  <option value="prefix">Di depan nama</option>
                  <option value="suffix">Di belakang nama</option>
                </select>
                <button id="save-custom-title-button-2" class="gm-button gm-button--quiet" type="button">Simpan gelar</button>
              </div>
              <div id="selected-titles-2" class="gm-selected-titles" aria-live="polite"></div>
              <p class="gm-help">Gelar depan tercetak sebelum nama, gelar belakang setelah nama. Urutannya dapat diubah.</p>
            </div>
          </section>
        </div>

        <div class="gm-field">
          <label class="gm-label" for="guest-status">Status pengiriman</label>
          <select id="guest-status" class="gm-input gm-select" name="status">
            <option value="pending">Belum dikirim</option>
            <option value="copied">Sudah disalin</option>
            <option value="sent">Sudah dikirim</option>
          </select>
        </div>

        <div class="gm-preview" aria-live="polite">
          <span class="gm-preview-label">Pratinjau di undangan</span>
          <strong id="guest-preview-name">Nama tamu</strong>
          <code id="guest-preview-url"></code>
        </div>
        <p id="guest-form-error" class="gm-error" role="alert" hidden></p>
        <div class="gm-dialog-actions">
          <button class="gm-button gm-button--quiet" type="button" data-close-dialog="guest-dialog">Batal</button>
          <button class="gm-button gm-button--primary" type="submit">Simpan Tamu</button>
        </div>
      </form>
    </dialog>

    <dialog id="template-dialog" class="gm-dialog" aria-labelledby="template-dialog-heading">
      <form id="template-form" class="gm-dialog-form" novalidate>
        <div class="gm-dialog-header">
          <div>
            <p class="gm-eyebrow">Dua template, dipilih per tamu</p>
            <h2 id="template-dialog-heading">Template Pesan</h2>
          </div>
          <button class="gm-icon-button" type="button" data-close-dialog="template-dialog" aria-label="Tutup template">×</button>
        </div>
        <p class="gm-help">Gunakan <code>{'{{nama_tamu}}'}</code> dan <code>{'{{link_undangan}}'}</code>. Pesan belum dapat disalin sebelum kedua placeholder tersedia.</p>
        <div class="gm-field gm-template-field">
          <label class="gm-label" for="message-template-friend">Template Untuk Teman</label>
          <textarea id="message-template-friend" class="gm-input gm-textarea" rows="10" maxlength="8000"></textarea>
        </div>
        <div class="gm-field gm-template-field">
          <label class="gm-label" for="message-template-parent">Template Untuk Orang Tua</label>
          <textarea id="message-template-parent" class="gm-input gm-textarea" rows="10" maxlength="8000"></textarea>
        </div>
        <p id="template-form-error" class="gm-error" role="alert" hidden></p>
        <div class="gm-dialog-actions">
          <button class="gm-button gm-button--quiet" type="button" data-close-dialog="template-dialog">Batal</button>
          <button class="gm-button gm-button--primary" type="submit">Simpan Template</button>
        </div>
      </form>
    </dialog>

    <div id="gm-toast" class="gm-toast" role="status" aria-live="polite" hidden></div>
    <script>
      import '../scripts/guest-manager.ts';
    </script>
  </body>
</html>
