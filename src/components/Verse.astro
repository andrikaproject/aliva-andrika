---
import { DEFAULT_LOCALE, translate } from '../i18n/index.ts';

const t = (key: string) => translate(DEFAULT_LOCALE, key);
---

<section id="verse" class="section-ground-down py-16 sm:py-20 px-4 sm:px-6">
  <div class="max-w-xl mx-auto text-center reveal">
    <p class="section-label mb-6 tracking-widest2">Q.S. Ar-Rūm : 21</p>

    <p class="verse-ayat" dir="rtl" lang="ar">
      وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجًا لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ
      بَيْنَكُم مَّوَدَّةً وَرَحْمَةً ۚ إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِّقَوْمٍ يَتَفَكَّرُونَ
    </p>

    <div class="gold-divider my-6 w-28 mx-auto"><span class="diamond"></span></div>

    <p class="verse-translation font-display italic text-text-rose leading-relaxed" data-i18n="verse.translation">
      {t('verse.translation')}
    </p>
  </div>
</section>
