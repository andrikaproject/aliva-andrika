---
import { couple, music } from '../data/wedding.ts';
import { DEFAULT_LOCALE, translate } from '../i18n/index.ts';

const t = (key: string) => translate(DEFAULT_LOCALE, key);
---

<!--
  preload="none" keeps a 1.3 MB track off the first paint. The cover button
  calls play() synchronously inside its click, which is what iOS requires,
  and the widget mirrors whatever playback actually does.
-->
<audio id="bg-audio" preload="none" loop>
  <source src={music.src} type={music.type} />
</audio>

<div id="music-widget" class="fixed bottom-6 right-4 sm:right-6 z-50 flex flex-col items-end gap-3">
  <div id="music-panel" class="music-panel panel px-4 py-3 w-56">
    <p class="section-label text-gold-deep mb-1" data-i18n="music.nowPlaying">{t('music.nowPlaying')}</p>
    <p class="font-display text-sm font-light text-ink leading-snug mb-2">
      <span data-i18n="music.trackTitle">{t('music.trackTitle')}</span><br />
      <span class="text-xs text-ink opacity-70 font-body not-italic">
        {couple.groom.firstName} &amp; {couple.bride.firstName}
      </span>
    </p>
    <div class="w-full h-px bg-gold-light rounded-full overflow-hidden">
      <div id="music-progress" class="h-full bg-gold-mid transition-all duration-300" style="width:0%"></div>
    </div>
  </div>

  <button id="music-btn" class="music-btn" type="button" aria-pressed="false" aria-label={t('a11y.musicToggle')}>
    <svg id="icon-note" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M9 3v10.55A4 4 0 1 0 11 17V7h4V3H9z"></path>
    </svg>
    <svg
      id="icon-mute"
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="hidden"
      aria-hidden="true"
    >
      <path d="M9 3v10.55A4 4 0 1 0 11 17V7h4V3H9zm0 16a2 2 0 1 1 0-4 2 2 0 0 1 0 4z" opacity=".4"></path>
      <line x1="3" y1="3" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
    </svg>
  </button>
</div>
